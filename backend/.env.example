# Synthetic local-only values. Copy to .env; never use these credentials in production.
NODE_ENV=development
PORT=3000
PROBE_PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
DB_AUTH_MODE=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=weather
PGUSER=weather_local
PGPASSWORD=replace-with-local-password
PGSSL=false
DB_POOL_MAX=5
OPENWEATHER_API_KEY=replace-with-your-local-key
WEATHER_TIMEOUT_MS=5000
# Production: NODE_ENV=production, PGSSL=true, DB_AUTH_MODE=entra,
# AZURE_CLIENT_ID=<API identity client ID>, FRONT_DOOR_ID=<exact profile ID>.
# PGUSER is the mapped SQL role, not an Azure client ID.
# Migration Job uses its own AZURE_CLIENT_ID/PGUSER and direct PostgreSQL port 5432.
