{
  "name": "weather-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=90000 --test-reporter=spec test/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "cleanup": "node dist/cleanup.js",
    "migrate:dev": "node --env-file=.env --import tsx src/migrate.ts",
    "cleanup:dev": "node --env-file=.env --import tsx src/cleanup.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "argon2": "0.45.1",
    "cookie": "^1.0.2",
    "express": "^5.2.1",
    "i18n-iso-countries": "^7.14.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.12.0",
    "expect": "^30.5.2",
    "jest-mock": "^30.5.2",
    "supertest": "^7.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
